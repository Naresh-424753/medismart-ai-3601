# Copy to .env and edit. For a quick demo with no database, leave MONGO_URL=mock.
MONGO_URL=mongodb://127.0.0.1:27017    # mock = in-memory demo database. For real use: mongodb://USER:PASSWORD@localhost:27017/?authSource=admin

DB_NAME=medismart
MONGO_FALLBACK=1
JWT_SECRET=DCRzp_FdHMDt5G9IhgAWhvdvSF01w9yJAB0Rs2OdUts702qrcTfBnjdYx2awuLk1          # REQUIRED when DEV_MODE=0: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_KEY=
# DEV_MODE=1 returns OTPs in API responses (demo). MUST be 0 in production.
DEV_MODE=1
SEED_DEMO=1
ADMIN_EMAIL=nk6395213@gmail.com          # your admin e-mail (required for first-run admin)
ADMIN_PASSWORD=RHSfaabFWvg24rZV         # leave empty to get a random one-time password in the server log
CORS_ORIGINS=http://localhost:5173
APP_TZ=Asia/Kolkata
# Optional delivery channels
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nk6395213@gmail.com
SMTP_PASS=nfrw bgej btlw
SMTP_FROM=nk6395213@gmail.com
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WA_FROM=
# Optional Google Gemini (free key: https://aistudio.google.com/apikey). Used first by AI Doctors + chatbot, with Google Search grounding
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SEARCH=1

# Optional LLM chatbot (Anthropic API key); without it the rule-based assistant is used
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Telemedicine (WebRTC)
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
TELE_ANYTIME=1

# Server-side speech-to-text (optional): Whisper API (OpenAI-compatible) and/or Bhashini
STT_PROVIDER=auto
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-1
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# Second opinion LLM method (optional) - same key the chatbot uses
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-5-5

# Demo data (SEED_DEMO=1): accounts are patient@<domain>, doctor1..6@<domain>, pharmacist@<domain>
DEMO_EMAIL_DOMAIN=demo.medismart.app
DEMO_PASSWORD=DemoRHSfaabFWvg24rZV       # empty -> random, printed once in the server log

# --- Google Cloud (optional) ---
# Database: create a free MongoDB Atlas cluster on Google Cloud and paste its connection string as MONGO_URL
#   (mongodb+srv://USER:PASSWORD@cluster.xxxx.mongodb.net/?retryWrites=true&w=majority). Add your IP in Atlas Network Access.
# Files: create a private Cloud Storage bucket, set its name here, and authenticate with
#   GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json (role: Storage Object Admin on that bucket only).
GCS_BUCKET=

# Contact page (optional)
SUPPORT_EMAIL=nk6395213@gmail.com
SUPPORT_PHONE=9560836752
# WhatsApp number with country code, digits only, e.g. 919876543210 (adds a WhatsApp button to the Contact page)
SUPPORT_WHATSAPP=9560836752

# Email via Brevo HTTPS API (use on Render free, which blocks SMTP). SMTP_FROM must be a sender verified in Brevo.
BREVO_API_KEY=

# ---- Prescription PDF header (shown on every PDF) ----
CLINIC_NAME=MediSmart AI 360 Clinic
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_REG_NO=
PUBLIC_API_URL=            # your backend URL, e.g. https://xxx.onrender.com  (used for the verify link/QR on the PDF)

# ---- WhatsApp / SMS medicine reminders via Twilio (leave empty to disable) ----
DEFAULT_COUNTRY_CODE=91
# (TWILIO_SID / TWILIO_TOKEN / TWILIO_SMS_FROM / TWILIO_WA_FROM are above; WhatsApp sandbox sender is whatsapp:+14155238886)

